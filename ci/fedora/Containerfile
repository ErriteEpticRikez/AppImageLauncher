ARG FEDORA_RELEASE=44
FROM registry.fedoraproject.org/fedora:${FEDORA_RELEASE}
# Bootstrap spec parsing and keep source/fixture orchestration tools separate.
RUN dnf5 -y install dnf5-plugins rpm-build systemd-rpm-macros \
    python3 git patch squashfs-tools
# Build from the repository-shaped committed source export, not ci/fedora alone.
COPY packaging/fedora/appimagelauncher.spec /tmp/appimagelauncher.spec
RUN dnf5 -y builddep /tmp/appimagelauncher.spec && \
    rm /tmp/appimagelauncher.spec && dnf5 clean all
