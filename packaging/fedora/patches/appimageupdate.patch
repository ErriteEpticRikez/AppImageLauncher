diff --git a/CMakeLists.txt b/CMakeLists.txt
index f00860f..5b7842c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,12 +9,7 @@ set(CMAKE_CXX_STANDARD_REQUIRED ON)
